ENVIRONMENT=homologacao
APP_NAME=LSAssist API - Homologacao
API_PREFIX=/api/v1

SUPABASE_URL=https://SEU_PROJECT_REF_DE_HOMOLOGACAO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA_DE_HOMOLOGACAO

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use uma chave exclusiva para a homologação.
EQUIPMENT_ENCRYPTION_KEY=

# Área de versões (somente homologação)
UPDATES_HOMOLOG_PROJECT_REF=ccoesxqurgafsslgstcu
# Token fine-grained: somente repositório sistema-assistencia-saas,
# Actions read/write + Contents read. Nunca usar VITE_ para esta variável.
UPDATES_GITHUB_TOKEN=
# Branch/tag protegida e revisada contendo o workflow. Não aponta para deploy.
UPDATES_GITHUB_REF=
